{
  "name": "ashad-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Secure Windows shell for the ASHAD controller",
  "author": "ASHAD",
  "main": "main.cjs",
  "scripts": {
    "prepare:runtime": "node prepare.cjs",
    "start": "electron .",
    "test": "node --test ../tests/test_desktop_shell.js",
    "build:dir": "npm run prepare:runtime && electron-builder --win --x64 --dir",
    "build:nsis": "npm run prepare:runtime && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "44.6.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.ashad.desktop",
    "productName": "ASHAD",
    "electronVersion": "44.6.0",
    "asar": true,
    "npmRebuild": false,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "directories": { "output": "output" },
    "files": ["main.cjs", "preload.cjs", "shell.cjs", "status.html", "package.json"],
    "extraResources": [
      { "from": "runtime/python", "to": "python", "filter": ["**/*", "!**/__pycache__/**", "!**/*.pyc",
        "!Lib/ensurepip/**", "!Lib/site-packages/pip/**", "!Lib/site-packages/pip-*.dist-info/**", "!Scripts/pip*"] },
      { "from": "python-requirements.lock", "to": "python-requirements.lock" }
    ],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }], "signAndEditExecutable": false },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
