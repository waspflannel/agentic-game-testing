# Normalize text to LF in the index and working tree (shell scripts, locks and tests are line-ending sensitive).
* text=auto eol=lf

# Never convert binary content.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.docx binary
*.zip binary
*.whl binary
*.exe binary
*.dll binary
*.pyd binary
